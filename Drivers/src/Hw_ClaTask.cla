#include "F2837xS_device.h"
#include "Hw_ClaTask.h"

#pragma CODE_SECTION(Cla1Task1, "Cla1Prog")

/* One 20 kHz hand-off. The task publishes the next MUX address for the CPU ISR
 * and clears the ADC interrupt flag. The sample itself is read by the CPU:
 * the ADC result registers are shared memory and are not touched here.
 * The CPU ISR changes the MUX GPIO after this task completes, so the new
 * address settles before the next CTR=ZERO sample. */
__interrupt void Cla1Task1(void)
{
    Uint16 address = CpuToCla1Msg.u16MuxAddress;

    if (address >= 8U || address == 5U)
    {
        address = 0U;
    }

    Cla1ToCpuMsg.u16NextMuxAddress = CpuToCla1Msg.u16NextMux[address];
    Cla1ToCpuMsg.u32Sequence++;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1U;
}
