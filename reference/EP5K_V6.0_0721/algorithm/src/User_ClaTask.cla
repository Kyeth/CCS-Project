//***************************************************************************
__interrupt void Cla1Task1(void)
{
    Cla1ToCpuMsg.cnt++;

    //多次采样
//    Cla1ToCpuMsg.muxV++;
//    Cla1ToCpuMsg.adresultV1Sum += AdccResultRegs.ADCRESULT4;
//    Cla1ToCpuMsg.adresultV2Sum += AdccResultRegs.ADCRESULT3;
//    if(Cla1ToCpuMsg.muxV >= 8L)
//    {
//        Cla1ToCpuMsg.muxV = 0;
//        Cla1ToCpuMsg.adresultV1 = Cla1ToCpuMsg.adresultV1Sum>>3;
//        Cla1ToCpuMsg.adresultV2 = Cla1ToCpuMsg.adresultV2Sum>>3;
//        Cla1ToCpuMsg.adresultV1Sum = 0;
//        Cla1ToCpuMsg.adresultV2Sum = 0;
//    }
//
//    AdccRegs.ADCSOCFRC1.bit.SOC3 = 1;
//    AdccRegs.ADCSOCFRC1.bit.SOC4 = 1;

    //多路选择器
    if(Cla1ToCpuMsg.turn == 0)
    {
        Cla1ToCpuMsg.adresult1[Cla1ToCpuMsg.mux] = AdcdResultRegs.ADCRESULT3;   //选通采样
        Cla1ToCpuMsg.adresult2[Cla1ToCpuMsg.mux] = AdcbResultRegs.ADCRESULT3;   //选通采样
        Cla1ToCpuMsg.mux++;
        if(Cla1ToCpuMsg.mux >= 8L)
            Cla1ToCpuMsg.mux = 0;

        //切换通道
        GpioDataRegs.GPBDAT.bit.GPIO46 = (Cla1ToCpuMsg.mux & 0x01)==0x01;
        GpioDataRegs.GPBDAT.bit.GPIO47 = (Cla1ToCpuMsg.mux & 0x02)==0x02;
        GpioDataRegs.GPBDAT.bit.GPIO42 = (Cla1ToCpuMsg.mux & 0x04)==0x04;

        Cla1ToCpuMsg.turn = 1;
    }
    else
    {
        AdcdRegs.ADCSOCFRC1.bit.SOC3 = 1;
        AdcbRegs.ADCSOCFRC1.bit.SOC3 = 1;
        Cla1ToCpuMsg.turn = 0;
    }
}

